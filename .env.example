# Cloud writes are OFF unless this is explicitly set to 1.
B2_ENABLED=0
B2_BUCKET=replace-with-your-public-demo-bucket
B2_REGION=us-west-004
B2_KEY_ID=replace-with-scoped-key-id
B2_APP_KEY=replace-with-scoped-application-key
B2_PUBLIC_URL_BASE=https://f004.backblazeb2.com/file/replace-with-your-public-demo-bucket
B2_PREFIX=proofcast

# Optional local settings.
PROOFCAST_OUTPUT_DIR=output
PROOFCAST_MAX_SCRIPT_CHARS=1200

